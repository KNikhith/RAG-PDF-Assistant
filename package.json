{
  "name": "rag-ai-pdf-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install && npm --prefix backend install --legacy-peer-deps && npm --prefix frontend install",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "build": "npm run install-all && npm --prefix frontend run build",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@google/genai": "^3.6.1"
  }
}
